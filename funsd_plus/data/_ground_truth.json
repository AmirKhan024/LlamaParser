  "funsd_001": {
    "headers": [
      "BRANDS BUSINESS UNIT PRODUCT APPROVAL NOTE"
    ],
    "key_value_pairs": [
      {
        "key": "BBU Note No.",
        "value": "96-61"
      },
      {
        "key": "Date:",
        "value": "8/5/96"
      },
      {
        "key": "Termination Date:",
        "value": "Permanent"
      },
      {
        "key": "Type:",
        "value": "Product"
      },
      {
        "key": "SUBJECT:",
        "value": "WINSTON Lt 100/CAMEL Lt 100 Specification Adjustments"
      },
      {
        "key": "BACKGROUND:",
        "value": "Specifications for all WINSTON and CAMEL products were recently reviewed. In some instances adjustments were recommended (previous BU Notes #96-31; #96- 39) while in other instances products/changes were still under investigation. In the case of WINSTON Lt 100/CAMEL Lt 100, BPU implementation initially caused drafts and dilutions to increase with a corresponding decrease in 'tar'. A subsequent paper change brought 'tar' values back up to target. Post BPU specification adjustments were made reflecting the higher drafts and dilutions. However, in the last six months, the drafts seem to be settling back to the pre-BPU levels. While investigations for an assignable cause are still underway (and include G-19 particle size; CRES filling capacity; others) the recommendation is to adjust specification targets back to what they were going in to BPU implementation."
      },
      {
        "key": "RECOMMENDATION:",
        "value": "The recommendation is to adjust HO and HC drafts and dilution targets back to where they were just as BPU implementation was occurring. Please refer to the attachment."
      },
      {
        "key": "RISK ASSESSMENT:",
        "value": "None. Adjustments are relatively minor."
      }
    ]
  },
