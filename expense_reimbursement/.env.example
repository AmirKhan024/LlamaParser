# Copy this file to .env and fill in real values. .env is gitignored.

# Credentials for the docker-compose Postgres service (docker-compose.yml
# reads these for the container itself; pick your own values).
POSTGRES_USER=expense_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=expense_db

# Used by db.py / alembic. Host port is 5433, not 5432 -- 5432 is left
# free in case a native Postgres install is already using it.
DATABASE_URL=postgresql+psycopg://expense_app:change-me@localhost:5433/expense_db

# A second, throwaway database on the same container (created automatically
# by docker/init-test-db.sh). pytest's autouse fixture TRUNCATEs every
# table in this database before each test -- never point it at expense_db.
TEST_DATABASE_URL=postgresql+psycopg://expense_app:change-me@localhost:5433/expense_test

# Required in PIPELINE_MODE=real. Get one at https://cloud.llamaindex.ai.
LLAMA_CLOUD_API_KEY=

# Required in PIPELINE_MODE=real. Get one at https://console.groq.com.
GROQ_API_KEY=

# real: calls LlamaParse + Groq for every upload (needs both keys above).
# fake: replays the cached outputs/*_result.json matching the upload's
#       sha256 (falls back to the phone-bill result) -- no keys needed.
#       Used by the UI when developing, by pytest, and by scripts/seed_demo.py.
PIPELINE_MODE=real

# The currency assumed for a document with no currency marker at all
# (see validate.resolve_currency) -- most bills in the company's own
# currency never print a symbol, so this is used instead of warning.
# Left unset, this defaults to INR.
COMPANY_CURRENCY=INR

# Which categorize.py method the pipeline uses to assign an expense
# category (categories.py) to each new document: rules | llm | classifier
# (hybrid exists in code but was never benchmarked -- don't use it).
# Default is `rules`: eval/categorization/RESULTS.md's decision rule ranks
# on accuracy over the real documents, where rules 83.7% > llm 69.8% >
# classifier 46.5%; llm wins only on all-documents accuracy (synthetic-
# heavy), so the winners split and `rules` stays -- it is free,
# deterministic and needs no API quota. `llm` (few-shot Groq
# gpt-oss-120b) costs ~1.6k tokens and ~4 s per document. A categorization
# failure always falls back to `rules` regardless of this setting -- it
# never fails the document itself.
CATEGORIZER=rules

# Stage 3 (policy compliance engine; see docs/STAGE3.md).
# Model that picks the governing clause per expense (temperature 0, JSON mode).
# Defaults to Stage 1's extract.MODEL (gpt-oss-120b). Note Groq's free tier caps
# this model at 200k tokens/day; one evaluation costs roughly 4-8k tokens per document.
POLICY_MODEL=openai/gpt-oss-120b
# Which prompts/policy_select_<version>.md to use. A prompt change is a NEW file
# and a new version here -- never an edit to v1.
POLICY_PROMPT_VERSION=v1
# Model scripts/build_policy.py uses to structure the policy prose (defaults to POLICY_MODEL's default).
POLICY_BUILD_MODEL=
# Where raw model responses are cached, keyed by a hash of the exact request.
# Default: storage/policy_cache
POLICY_CACHE_DIR=
